<templates xml:space="preserve">

    <t
        t-name="l10n_ve_accountant.TaxGroupComponent"
        t-inherit="account.TaxGroupComponent"
        t-inherit-mode="extension"
        owl="1">
        <xpath expr="//tr/td[2]/t[@t-if]/t[@t-else]/span/span" position="replace">
            <span class="o_tax_group_amount_value o_tree_monetary">
                <t t-out="props.taxGroup.formatted_tax_group_amount"/>
            </span>
        </xpath>
        <xpath expr="//tr" position="before">
            <tr>
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label" t-esc="'Total G ' + props.taxGroup.tax_group_name"/>
                </td>

                <td class="o_tax_group">
                    <span class="o_tax_group_amount_value o_tree_monetary">
                        <t t-out="props.taxGroup.formatted_tax_group_base_amount" style="white-space: nowrap;"/>
                    </span>
                </td>
            </tr>
        </xpath>
    </t>

    <t t-name="l10n_ve_tax.TaxTotalsField" t-inherit="account.TaxTotalsField" t-inherit-mode="extension" owl="1">
        <!-- Inyección DIRECTA de moneda dual para evitar errores de registro de componentes -->
        <xpath expr="//table[1]" position="before">
            <t t-if="totals">
                <!-- Bloque de Moneda Extranjera (Dólares) -->
                <table class="oe_right oe_subtotal_footer" style="width: 100%; border-collapse: collapse;">
                    <tbody>
                        <!-- Subtotal USD (Base Ref) -->
                        <tr>
                            <td class="o_td_label" style="padding: 2px 8px; text-align: right;">
                                <label class="o_form_label" style="font-weight: normal;">Base Ref.:</label>
                            </td>
                            <td style="padding: 2px 8px; text-align: right; width: 120px;">
                                <span t-out="totals.foreign_formatted_amount_untaxed" style="white-space: nowrap;"/>
                            </td>
                        </tr>
                        
                        <!-- Impuestos USD (Impuesto Ref) -->
                        <t t-foreach="totals.groups_by_foreign_subtotal || {}" t-as="subtotal_name" t-key="subtotal_name">
                           <t t-foreach="totals.groups_by_foreign_subtotal[subtotal_name]" t-as="tax_group" t-key="tax_group.group_key">
                                <tr>
                                    <td class="o_td_label" style="padding: 2px 8px; text-align: right;">
                                        <label class="o_form_label" style="font-weight: normal;" t-esc="'Impuesto Ref. ' + tax_group.tax_group_name + ':'"/>
                                    </td>
                                    <td style="padding: 2px 8px; text-align: right;">
                                        <span t-out="tax_group.formatted_tax_group_amount" style="white-space: nowrap;"/>
                                    </td>
                                </tr>
                           </t>
                        </t>

                        <!-- Total USD (Total Ref) -->
                        <tr style="border-top: 1px solid #dee2e6;">
                            <td class="o_td_label" style="padding: 4px 8px; text-align: right;">
                                <label class="o_form_label" style="font-weight: bold; font-size: 1.1em;">Total Ref.:</label>
                            </td>
                            <td style="padding: 4px 8px; text-align: right;">
                                <span t-out="totals.foreign_formatted_amount_total" style="font-weight: bold; font-size: 1.2em; white-space: nowrap; color: #000;"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div style="border-bottom: 1px solid #dee2e6; margin: 10px 0; width: 100%; float: right;"/>
            </t>
        </xpath>

        <xpath expr="//table[1]/tbody[1]/t[1]" position="before">
            <tr t-if="totals.discount_amount and totals.show_discount">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Subtotal</label>
                </td>
                <td>
                    <span
                        name="subtotal"
                        class="o_tax_group_amount_value o_tree_monetary"
                        t-out="totals.formatted_subtotal"
                    />
                </td>
            </tr>
            <tr t-if="totals.discount_amount and totals.show_discount">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Discount</label>
                </td>
                <td class="o_tax_group">
                    <span
                        name="discount_amount"
                        class="o_tax_group_amount_value o_tree_monetary"
                        t-out="totals.formatted_discount_amount"
                    />
                </td>
            </tr>
        </xpath>
    </t>

    <t t-name="l10n_ve_tax.TaxForeignTotalsField" owl="1">
        <table t-if="totals" class="oe_right">
            <tbody>
                <tr t-if="totals.foreign_discount_amount and totals.show_discount">
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Subtotal</label>
                    </td>
                    <td>
                        <span
                            name="foreign_amount_untaxed"
                            class="o_tax_group_amount_value o_tree_monetary"
                            t-out="totals.foreign_formatted_subtotal"
                        />
                    </td>
                </tr>
                <tr t-if="totals.foreign_discount_amount and totals.show_discount">
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Discount</label>
                    </td>
                    <td class="o_tax_group">
                        <span
                            name="foreign_discount_amount"
                            class="o_tax_group_amount_value o_tree_monetary"
                            t-out="totals.foreign_formatted_discount_amount"
                        />
                    </td>
                </tr>
                <t t-if="totals.foreign_subtotals and totals.foreign_subtotals.length > 0">
                    <t t-foreach="totals.foreign_subtotals" t-as="subtotal" t-key="subtotal['name']">
                        <tr>
                            <td class="o_td_label">
                                <label class="o_form_label o_tax_total_label" t-esc="subtotal['name']"/>
                            </td>

                            <td class="o_tree_monetary">
                                <span t-att-name="subtotal['name']" style="white-space: nowrap; font-weight: bold;" t-out="subtotal['formatted_amount']"/>
                            </td>
                        </tr>
                        <t t-if="totals.groups_by_foreign_subtotal and totals.groups_by_foreign_subtotal[subtotal['name']] and totals.groups_by_foreign_subtotal[subtotal['name']].length > 0">
                            <t t-foreach="totals.groups_by_foreign_subtotal[subtotal['name']]" t-as="taxGroup" t-key="taxGroup.group_key">
                                <TaxGroupComponent
                                    currency="currency"
                                    taxGroup="taxGroup"
                                    isReadonly="readonly"
                                    onChangeTaxGroup.bind="_onChangeTaxValueByTaxGroup"
                                    invalidate.bind="invalidate"
                                />
                            </t>
                        </t>
                        </t>
                </t>
                <tr>
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Total</label>
                    </td>

                    <td class="o_tree_monetary">
                        <span
                            name="foreign_amount_total"
                            t-att-class="Object.keys(totals.groups_by_subtotal).length > 0 ? 'oe_subtotal_footer_separator' : ''"
                            t-out="totals.foreign_formatted_amount_total"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                </tr>
            </tbody>
        </table>
    </t>
</templates>
