<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_intermediation" model="ir.ui.view">
            <field name="name">res.partner.form.intermediation</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="l10n_ve_payment_extension.res_partner_binaural_payment_extension"/>
            <field name="arch" type="xml">
                <!-- Inyectar campos de intermediación inmediatamente después del tipo de retención -->
                <xpath expr="//field[@name='withholding_type_id']" position="after">
                    <field name="is_intermediary" string="¿Es Intermediario?" widget="boolean_toggle"/>
                    
                    <field name="intermediation_case_id" 
                           string="Caso de Intermediación"
                           invisible="not is_intermediary"
                           required="is_intermediary"
                           options="{'no_create': True, 'no_edit': True}"/>
                           
                    <field name="force_100_retention" 
                           string="Forzar 100% IVA"
                           invisible="not is_intermediary"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
