<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Heredar vista de formulario de Retención IVA para agregar alerta de intermediación -->
        <record id="view_retention_iva_form_inherit_intermediation" model="ir.ui.view">
            <field name="name">account.retention.iva.form.inherit.intermediation</field>
            <field name="model">account.retention</field>
            <field name="inherit_id" ref="l10n_ve_payment_extension.view_retention_iva_form_binaural_payment_extension"/>
            <field name="arch" type="xml">
                <xpath expr="//group[1]" position="before">
                    <field name="is_intermediation" invisible="1"/>
                    <field name="intermediation_warning" widget="html" nolabel="1" invisible="not is_intermediation"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="partner_is_intermediary" invisible="1"/>
                    <field name="is_mediated_retention" 
                           invisible="not partner_is_intermediary" 
                           readonly="state in ['emitted', 'cancel']" 
                           widget="boolean_toggle"/>
                    <field name="printed_partner_id" 
                           string="Sujeto Intermediado" 
                           invisible="not is_mediated_retention" 
                           required="is_mediated_retention" 
                           readonly="state in ['emitted', 'cancel']" 
                           options="{'no_create': True}"/>
                    <field name="printed_partner_vat" 
                           invisible="not is_mediated_retention"/>
                </xpath>
            </field>
        </record>

