<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_inherit_intermediation" model="ir.ui.view">
            <field name="name">product.template.form.view.inherit.intermediation</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="l10n_ve_payment_extension.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ciu_ids']" position="after">
                    <group string="Intermediación Comercial">
                        <field name="mediated_partner_id" options="{'no_create': True}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
