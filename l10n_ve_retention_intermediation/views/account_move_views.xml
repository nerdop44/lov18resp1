<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_intermediation" model="ir.ui.view">
            <field name="name">account.move.form.intermediation</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Inyectar aviso reactivo sobre el notebook de las líneas de factura -->
                <xpath expr="//notebook" position="before">
                    <field name="intermediation_warning" widget="html" nolabel="1" invisible="not is_intermediation"/>
                </xpath>

                <!-- 1. Inyectar campos de intermediación de forma responsiva y alineada en la cabecera de la factura -->
                <xpath expr="//group[@id='header_left_group']" position="inside">
                    <!-- Campo técnico para control de visibilidad en UI -->
                    <field name="partner_is_intermediary" invisible="1"/>
                    
                    <group string="Intermediación Comercial" invisible="1">
                        <field name="is_intermediation" 
                               string="¿Es Factura de Intermediación?"
                               widget="boolean_toggle"/>
                               
                        <field name="intermediation_case_id"
                               string="Caso de Intermediación"
                               invisible="not is_intermediation"
                               required="is_intermediation"
                               options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                </xpath>
 
                <!-- 2. Inyectar columnas especiales en la cuadrícula de líneas de la factura (usando list[last()]) -->
                <xpath expr="//field[@name='invoice_line_ids']/list[last()]/field[@name='price_subtotal']" position="before">
                    <field name="is_intermediation_commission"
                           string="¿Es Comisión?"
                           column_invisible="not parent.is_intermediation"
                           invisible="display_type in ('line_section', 'line_note')"
                           help="Marque si esta línea corresponde al honorario o comisión de la Agencia."
                           optional="show"/>
                           
                    <field name="mediated_partner_id"
                           string="Sujeto Intermediado"
                           column_invisible="not parent.is_intermediation"
                           invisible="display_type in ('line_section', 'line_note')"
                           options="{'no_create': True}"
                           help="Asigne el prestador de servicio real (ej. la aerolínea nacional). Deje en blanco para aerolíneas internacionales (vuelos internacionales) exentos de retención."
                           optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
