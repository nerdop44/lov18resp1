<odoo>
	<data>
		<record id="account_move_form_binaural_payment_extension_krill" model="ir.ui.view">
			<field name="name">account.move.form.binaural.payment.extension.krill</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_move_form"/>
			<field name="arch" type="xml">
                <!-- Cambiar etiqueta de invoice_date a "Fecha de Factura" -->
                <xpath expr="//field[@name='invoice_date']" position="attributes">
                    <attribute name="string">Fecha de Factura</attribute>
                </xpath>

                <!-- Asegurarse de que 'date' tenga etiqueta clara -->
                <xpath expr="//field[@name='date']" position="attributes">
                    <attribute name="string">Fecha Contable</attribute>
                </xpath>

                <!-- Mover 'date' justo después de 'invoice_date' para mejor UX -->
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="date" string="Fecha Contable" invisible="move_type == 'entry'"/>
                </xpath>

                <!-- Si 'date' ya está en otra parte, ocultarlo para evitar duplicados -->
                <xpath expr="//field[@name='date'][position()>1]" position="replace"/>

                <!-- Campos de retenciones en la cabecera -->
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="generate_iva_retention" string="¿Generar Retención de IVA?" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                    <field name="iva_voucher_number" string="Nro. Comprobante IVA" readonly="1" invisible="not iva_voucher_number"/>
                    <field name="islr_voucher_number" string="Nro. Comprobante ISLR" readonly="1" invisible="not islr_voucher_number"/>
                    <field name="municipal_voucher_number" string="Nro. Comprobante Municipal" readonly="1" invisible="not municipal_voucher_number"/>
                </xpath>

                <!-- Pestañas de retenciones en la factura -->
				<xpath expr="//notebook" position="inside">
					<page name="iva_retention" string="Retenciones de IVA" invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')">
						<field name="retention_iva_line_ids" nolabel="1" readonly="1">
							<list editable="bottom">
								<field name="invoice_type" column_invisible="True"/>
								<field name="company_currency_id" column_invisible="True"/>
								<field name="foreign_currency_id" column_invisible="True"/>
								<field name="name" string="Nombre"/>
								<field name="move_id" string="Factura"/>
								<field name="aliquot" string="Alícuota %"/>
								<field name="related_percentage_tax_base" optional="hide" string="% Base Imponible"/>
								
								<field name="invoice_total" string="Total Factura (Bs)" widget="monetary" options="{'currency_field': 'company_currency_id'}" column_invisible="not parent.base_currency_is_vef" />
								<field name="invoice_amount" string="Base Imponible (Bs)" widget="monetary" options="{'currency_field': 'company_currency_id'}" column_invisible="not parent.base_currency_is_vef" />
								<field name="iva_amount" string="Monto IVA (Bs)" widget="monetary" options="{'currency_field': 'company_currency_id'}" column_invisible="not parent.base_currency_is_vef" />
								<field name="retention_amount" string="Monto Retenido (Bs)" widget="monetary" options="{'currency_field': 'company_currency_id'}" column_invisible="not parent.base_currency_is_vef" />
								
								<field name="foreign_invoice_amount" string="Base Imponible ($)" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef" />
								<field name="foreign_iva_amount" string="Monto IVA ($)" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef" />
								<field name="foreign_invoice_total" string="Total Factura ($)" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef" />
								<field name="foreign_retention_amount" string="Monto Retenido ($)" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef" />
								<field name="foreign_currency_rate" string="Tasa" optional="hide"/>
								<field name="state" string="Estado"/>
							</list>
						</field>
					</page>
					<page name="islr_retention" string="Retenciones de ISLR" invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')">
						<field name="retention_islr_line_ids" nolabel="1" readonly="move_type not in ('in_invoice', 'in_refund') or state != 'draft'">
							<list editable="bottom">
							    <field name="invoice_type" column_invisible="True"/>
								<field name="company_currency_id" column_invisible="True"/>
								<field name="foreign_currency_id" column_invisible="True"/>
								<field name="name" string="Nombre"/>
								<field name="payment_concept_id" string="Concepto de Retención"/>
								<field name="invoice_total" string="Total Factura (Bs)" force_save="1" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1" column_invisible="not parent.base_currency_is_vef"/>
								<field name="foreign_invoice_total" string="Total Factura ($)" force_save="1" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" readonly="1" column_invisible="parent.base_currency_is_vef"/>
								<field name="invoice_amount" string="Base Imponible (Bs)" force_save="1" widget="monetary" options="{'currency_field': 'company_currency_id'}" column_invisible="not parent.base_currency_is_vef"/>
								<field name="foreign_invoice_amount" string="Base Imponible ($)" force_save="1" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef"/>
								<field name="related_pay_from" string="Paga Desde" force_save="1" readonly="1" />
								<field name="related_percentage_tax_base" string="% Base Imponible" force_save="1" readonly="1" />
								<field name="related_percentage_fees" string="% Retención" force_save="1" readonly="1" />
								<field name="related_amount_subtract_fees" string="Sustraendo" force_save="1" readonly="1" />
								<field name="foreign_currency_rate" string="Tasa" force_save="1" readonly="1" optional="hide" />
								<field name="retention_amount" string="Monto Retenido (Bs)" force_save="1" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1" column_invisible="not parent.base_currency_is_vef"/>
								<field name="foreign_retention_amount" string="Monto Retenido ($)" widget="monetary" force_save="1" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef"/>
								<field name="state" string="Estado"/>
							</list>
						</field>
					</page>
					<page name="municipal_retention" string="Retenciones Municipales" invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')">
						<field name="retention_municipal_line_ids" nolabel="1" readonly="move_type not in ('in_invoice', 'in_refund') or state != 'draft'">
							<list editable="bottom">
								<field name="name" string="Nombre" force_save="1" readonly="1"/>
								<field name="economic_activity_id" string="Actividad Económica" force_save="1"/>
								<field name="aliquot" string="Alícuota %" readonly="1" force_save="1"/>
								<field name="invoice_amount" string="Base Imponible (Bs)" force_save="1" widget="monetary" options="{'currency_field': 'company_currency_id'}" column_invisible="not parent.base_currency_is_vef"/>
								<field name="invoice_total" string="Total Factura (Bs)" force_save="1" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1" column_invisible="not parent.base_currency_is_vef"/>
								<field name="retention_amount" string="Monto Retenido (Bs)" force_save="1" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1" column_invisible="not parent.base_currency_is_vef"/>
								<field name="foreign_invoice_amount" string="Base Imponible ($)" force_save="1" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef"/>
								<field name="foreign_invoice_total" string="Total Factura ($)" force_save="1" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" readonly="1" column_invisible="parent.base_currency_is_vef"/>
								<field name="foreign_retention_amount" string="Monto Retenido ($)" widget="monetary" force_save="1" options="{'currency_field': 'foreign_currency_id'}" column_invisible="parent.base_currency_is_vef"/>
								<field name="foreign_currency_rate" string="Tasa" force_save="1" readonly="1" optional="hide" />
								<field name="state" string="Estado" force_save="1"/>
							</list>
						</field>
					</page>
				</xpath>
			</field>
		</record>
	</data>
</odoo>
